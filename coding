<div>
  <div class="bg-white/10 p-4 rounded-3xl relative">

    <img
      id="heroCarImage"
      src="toyota avanza.png"
      alt="Toyota Avanza"
      class="w-full h-[400px] object-cover rounded-2xl transition duration-500">

    <!-- TOMBOL KIRI -->
    <button
      onclick="prevCar()"
      class="absolute left-7 top-1/2 -translate-y-1/2
             w-10 h-10 rounded-full bg-black/60
             text-white text-xl hover:bg-orange-500 transition">
      ‹
    </button>

    <!-- TOMBOL KANAN -->
    <button
      onclick="nextCar()"
      class="absolute right-7 top-1/2 -translate-y-1/2
             w-10 h-10 rounded-full bg-black/60
             text-white text-xl hover:bg-orange-500 transition">
      ›
    </button>

    <!-- INDICATOR -->
    <div class="absolute bottom-7 left-1/2 -translate-x-1/2 flex gap-2">
      <span class="dot w-2.5 h-2.5 rounded-full bg-orange-500"></span>
      <span class="dot w-2.5 h-2.5 rounded-full bg-white/40"></span>
      <span class="dot w-2.5 h-2.5 rounded-full bg-white/40"></span>
    </div>

  </div>
</div>
const heroCars = [
  {
    image: "toyota avanza.png",
    name: "Toyota Avanza"
  },
  {
    image: "honda brio.png",
    name: "Honda Brio"
  },
  {
    image: "daihatsu xenia.png",
    name: "Daihatsu Xenia"
  }
];

let currentCar = 0;

function showCar(index) {
  currentCar = index;

  const image = document.getElementById('heroCarImage');
  image.src = heroCars[currentCar].image;
  image.alt = heroCars[currentCar].name;

  document.querySelectorAll('.dot').forEach((dot, i) => {
    dot.classList.toggle('bg-orange-500', i === currentCar);
    dot.classList.toggle('bg-white/40', i !== currentCar);
  });
}

function nextCar() {
  currentCar = (currentCar + 1) % heroCars.length;
  showCar(currentCar);
}

function prevCar() {
  currentCar = (currentCar - 1 + heroCars.length) % heroCars.length;
  showCar(currentCar);
}
  
